# TV Channel Sources
VITE_TV_CHANNEL_SOURCES=https://tv-sources.example.com/
VITE_TV_API_URL=https://tv-api.example.com/index.json
VITE_TV_API_ACCESS_TOKEN=your_tv_access_token_here
VITE_EPG_API_URL=https://epg.example.com/api/schedule
VITE_API_EPG=https://epg.example.com/api/schedule/{channelId}

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
